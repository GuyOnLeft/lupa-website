  <!-- Globe + i18n -->
  <script type="module">
import * as THREE from 'three';

// ── Translations ──────────────────────────────────────────────────
const T = {
  en: {
    'nav-cta':        'Request a Demo',
    'nav-products':   'Products',
    'nav-methodology':'Methodology',
    'hero-sys':       '// Parcel intelligence · active',
    'hero-headline':  'We see what<br><em>others don\'t.</em>',
    'hero-sub':       'Cross-jurisdiction parcel data intelligence for county governments — built entirely on public records.',
    'hero-cta':       'Request a Demo →',
    'cta-headline':   'Ready to see what your records already know?',
    'cta-sub':        'We run a pilot audit of your jurisdiction. You see what we find.',
    'cta-link':       'Request a Demo →',
    'footer-tagline': 'Parcel Intelligence Platform',
  },
  es: {
    'nav-cta':        'Solicitar una Demo',
    'nav-products':   'Productos',
    'nav-methodology':'Metodología',
    'hero-sys':       '// Inteligencia predial · activo',
    'hero-headline':  'Vemos lo que<br><em>otros no ven.</em>',
    'hero-sub':       'Inteligencia de datos prediales entre jurisdicciones para gobiernos locales — construida íntegramente sobre registros públicos.',
    'hero-cta':       'Solicitar una Demo →',
    'cta-headline':   '¿Listo para ver lo que sus registros ya saben?',
    'cta-sub':        'Realizamos una auditoría piloto de su jurisdicción. Usted ve lo que encontramos.',
    'cta-link':       'Solicitar una Demo →',
    'footer-tagline': 'Plataforma de Inteligencia Predial',
  }
};

// ── Language toggle ───────────────────────────────────────────────
let lang = 'en';
const langBtn = document.getElementById('lang-btn');

function applyLang(l) {
  lang = l;
  document.documentElement.lang = l;
  document.querySelectorAll('[data-i18n]').forEach(el => {
    const key = el.getAttribute('data-i18n');
    if (T[l][key] !== undefined) el.innerHTML = T[l][key];
  });
  langBtn.textContent = l === 'en' ? 'ES' : 'EN';
}

langBtn.addEventListener('click', () => applyLang(lang === 'en' ? 'es' : 'en'));

// ── Globe (Three.js) ──────────────────────────────────────────────
const canvas = document.getElementById('scan-canvas');
const renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true });
renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
renderer.setClearColor(0x000000, 0);

const scene  = new THREE.Scene();
const camera = new THREE.PerspectiveCamera(42, 1, 0.1, 100);
camera.position.z = 3;

function resize() {
  const w = window.innerWidth, h = window.innerHeight;
  renderer.setSize(w, h);
  camera.aspect = w / h;
  camera.updateProjectionMatrix();
}

function applyLayout() {
  const mobile = window.innerWidth < 900;
  earth.position.x    = mobile ? 0   : 1.1;
  atmoMesh.position.x = mobile ? 0   : 1.1;
  haloMesh.position.x = mobile ? 0   : 1.1;
  camera.position.z   = mobile ? 2.6 : 3;
}

resize();
window.addEventListener('resize', () => { resize(); applyLayout(); });

// Earth sphere
const earthGeo = new THREE.SphereGeometry(1, 64, 64);
const earthMat = new THREE.MeshPhongMaterial({ specular: new THREE.Color(0x112233), shininess: 14 });
const earth    = new THREE.Mesh(earthGeo, earthMat);
earth.position.x = 1.1;
scene.add(earth);

// Atmosphere shell
const atmoMesh = new THREE.Mesh(
  new THREE.SphereGeometry(1.04, 64, 64),
  new THREE.MeshPhongMaterial({ color: 0x4499cc, transparent: true, opacity: 0.05, depthWrite: false })
);
atmoMesh.position.x = 1.1;
scene.add(atmoMesh);

// Outer glow
const haloMesh = new THREE.Mesh(
  new THREE.SphereGeometry(1.18, 64, 64),
  new THREE.MeshBasicMaterial({
    color: 0x1a4466, transparent: true, opacity: 0.1,
    side: THREE.BackSide, blending: THREE.AdditiveBlending, depthWrite: false
  })
);
haloMesh.position.x = 1.1;
scene.add(haloMesh);

applyLayout();

// Lighting
const sun = new THREE.DirectionalLight(0xfff8f0, 1.6);
sun.position.set(4, 2, 5);
scene.add(sun);
scene.add(new THREE.AmbientLight(0x223344, 0.75));

// Texture — try NASA via threejs.org, fall back to procedural
function buildFallbackTexture() {
  const W = 2048, H = 1024;
  const cv = document.createElement('canvas');
  cv.width = W; cv.height = H;
  const c = cv.getContext('2d');
  const og = c.createLinearGradient(0, 0, 0, H);
  og.addColorStop(0, '#0b2e4e'); og.addColorStop(.5, '#0f3d62'); og.addColorStop(1, '#0b2e4e');
  c.fillStyle = og; c.fillRect(0, 0, W, H);
  function poly(pts, fill) {
    c.beginPath();
    pts.forEach(([lo, la], i) => {
      const x = (lo + 180) / 360 * W, y = (90 - la) / 180 * H;
      i === 0 ? c.moveTo(x, y) : c.lineTo(x, y);
    });
    c.closePath(); c.fillStyle = fill; c.fill();
  }
  const land = '#3d6b2a', dry = '#7a7040', trop = '#2d6020', ice = '#d4e8f0';
  poly([[-168,72],[-130,70],[-100,68],[-85,50],[-83,46],[-70,44],[-67,47],[-56,47],[-60,46],[-64,44],[-70,42],[-75,38],[-77,35],[-80,32],[-81,25],[-90,16],[-87,14],[-83,10],[-77,8],[-65,10],[-58,12],[-62,10],[-53,4],[-70,12],[-86,16],[-90,18],[-105,20],[-110,24],[-118,32],[-120,34],[-124,38],[-124,48],[-130,55],[-140,60],[-150,61],[-160,60],[-170,63],[-168,72]], land);
  poly([[-44,84],[-20,77],[-18,64],[-44,60],[-52,62],[-56,70],[-44,84]], '#4a7a3a');
  poly([[-81,8],[-77,8],[-65,10],[-53,4],[-50,2],[-36,-4],[-35,-10],[-38,-18],[-42,-22],[-52,-32],[-68,-54],[-74,-52],[-80,-40],[-80,-20],[-78,-2],[-80,2],[-81,8]], trop);
  poly([[-10,36],[0,37],[8,37],[14,37],[20,37],[26,38],[32,40],[34,42],[30,46],[28,48],[20,48],[16,48],[14,50],[10,54],[8,58],[4,58],[-2,54],[-4,48],[-8,44],[-10,36]], land);
  poly([[10,54],[14,54],[18,56],[20,58],[16,60],[12,58],[10,54]], land);
  poly([[16,56],[18,58],[22,64],[24,68],[28,72],[30,70],[26,64],[22,58],[18,56]], land);
  poly([[-5,50],[-2,50],[2,52],[-1,54],[-4,56],[-2,58],[-4,60],[-6,58],[-5,52],[-5,50]], land);
  poly([[-18,16],[-17,14],[-15,10],[-8,4],[-2,4],[2,4],[8,2],[14,-2],[18,-18],[22,-34],[28,-36],[34,-26],[38,-12],[40,0],[42,10],[44,12],[42,14],[38,18],[34,22],[32,32],[28,34],[22,36],[16,38],[8,36],[2,36],[-2,36],[-6,32],[-10,28],[-16,22],[-18,16]], land);
  poly([[32,32],[38,30],[50,28],[58,22],[58,12],[48,12],[44,12],[42,14],[38,18],[34,22],[32,32]], dry);
  poly([[28,70],[40,72],[60,74],[80,72],[80,52],[60,50],[50,44],[40,42],[36,42],[28,48],[28,58],[28,70]], land);
  poly([[80,72],[100,74],[120,72],[140,70],[160,64],[170,60],[166,54],[156,52],[140,46],[130,44],[120,50],[100,52],[80,52],[80,72]], land);
  poly([[50,44],[60,50],[80,52],[80,44],[72,38],[62,36],[50,38],[50,44]], dry);
  poly([[66,24],[68,28],[72,34],[76,36],[80,28],[78,20],[76,10],[72,8],[68,8],[66,14],[66,24]], land);
  poly([[100,22],[106,24],[110,22],[116,24],[118,20],[114,4],[106,2],[102,4],[100,8],[100,22]], trop);
  poly([[76,38],[82,28],[88,28],[92,28],[96,26],[100,22],[106,24],[110,22],[118,26],[120,32],[122,38],[120,44],[114,42],[110,38],[106,36],[100,36],[94,38],[86,34],[80,28],[76,38]], land);
  poly([[120,32],[126,34],[130,36],[132,40],[128,40],[124,36],[120,32]], land);
  poly([[130,32],[132,34],[138,40],[142,42],[144,40],[140,36],[136,34],[130,32]], land);
  poly([[114,-22],[118,-20],[126,-14],[132,-12],[136,-12],[140,-14],[142,-16],[148,-20],[152,-24],[152,-30],[148,-38],[140,-38],[130,-36],[118,-34],[114,-26],[114,-22]], '#7a8038');
  c.fillStyle = ice; c.fillRect(0, H * .86, W, H * .14);
  const ag = c.createLinearGradient(0, 0, 0, H * .08);
  ag.addColorStop(0, 'rgba(210,230,245,0.85)'); ag.addColorStop(1, 'rgba(210,230,245,0)');
  c.fillStyle = ag; c.fillRect(0, 0, W, H * .08);
  return new THREE.CanvasTexture(cv);
}

const texLoader = new THREE.TextureLoader();
texLoader.crossOrigin = 'anonymous';
texLoader.load(
  'https://threejs.org/examples/textures/land_ocean_ice_cloud_2048.jpg',
  tex  => { earthMat.map = tex; earthMat.needsUpdate = true; },
  undefined,
  _err => { earthMat.map = buildFallbackTexture(); earthMat.needsUpdate = true; }
);

function makeRingTex(size = 128) {
  const cv = document.createElement('canvas'); cv.width = cv.height = size;
  const c = cv.getContext('2d'), m = size / 2;
  c.strokeStyle = '#F0B500'; c.lineWidth = size * 0.055;
  c.shadowColor = '#F0B500'; c.shadowBlur  = size * 0.15;
  c.beginPath(); c.arc(m, m, m * 0.62, 0, Math.PI * 2); c.stroke();
  return new THREE.CanvasTexture(cv);
}
function makeDotTex(size = 64) {
  const cv = document.createElement('canvas'); cv.width = cv.height = size;
  const c = cv.getContext('2d'), m = size / 2;
  c.fillStyle = '#F0B500'; c.shadowColor = '#F0B500'; c.shadowBlur = size * 0.4;
  c.beginPath(); c.arc(m, m, m * 0.38, 0, Math.PI * 2); c.fill();
  return new THREE.CanvasTexture(cv);
}
const ringTex = makeRingTex();
const dotTex  = makeDotTex();

function latLonTo3D(lat, lon, r = 1) {
  const phi   = (90 - lat)  * (Math.PI / 180);
  const theta = (lon + 180) * (Math.PI / 180);
  return new THREE.Vector3(
    -r * Math.sin(phi) * Math.cos(theta),
     r * Math.cos(phi),
     r * Math.sin(phi) * Math.sin(theta)
  );
}

const INITIAL_ROT = -90 * (Math.PI / 180);

const SITES = [
  { lat:  40.71, lon:  -74.0,  label: 'NYC',        coords: ['40.7128°N', '74.0060°W']  },
  { lat:  37.78, lon: -122.4,  label: 'SFO',        coords: ['37.7749°N', '122.4194°W'] },
  { lat:  41.88, lon:  -87.6,  label: 'CHICAGO',    coords: ['41.8781°N', '87.6298°W']  },
  { lat:  29.76, lon:  -95.4,  label: 'HOUSTON',    coords: ['29.7604°N', '95.3698°W']  },
  { lat:  26.64, lon:  -81.87, label: 'LEE COUNTY', coords: ['26.6406°N', '81.8723°W']  },
  { lat:  51.50, lon:   -0.12, label: 'LONDON',     coords: ['51.5074°N', '0.1278°W']   },
  { lat:  35.68, lon:  139.7,  label: 'TOKYO',      coords: ['35.6762°N', '139.6503°E'] },
  { lat:  33.75, lon:  -84.4,  label: 'ATLANTA',    coords: ['33.7490°N', '84.3880°W']  },
];

const SURF_R = 1.05;

const siteObjs = SITES.map(site => {
  const pos = latLonTo3D(site.lat, site.lon, SURF_R);

  const dot = new THREE.Sprite(new THREE.SpriteMaterial({
    map: dotTex, transparent: true, opacity: 0.95,
    depthTest: true, depthWrite: false,
  }));
  dot.position.copy(pos);
  dot.scale.setScalar(0.06);
  dot.renderOrder = 2;
  earth.add(dot);

  const rings = [0, 0.5].map(offset => {
    const sp = new THREE.Sprite(new THREE.SpriteMaterial({
      map: ringTex, transparent: true, opacity: 0,
      depthTest: true, depthWrite: false,
      blending: THREE.AdditiveBlending,
    }));
    sp.position.copy(pos);
    sp.userData.phase = offset;
    sp.renderOrder = 2;
    earth.add(sp);
    return sp;
  });

  return { site, dot, rings };
});

let coordIdx = 0;
setInterval(() => {
  coordIdx = (coordIdx + 1) % SITES.length;
  const s = SITES[coordIdx];
  document.getElementById('scan-coords').innerHTML =
    `${s.coords[0]}&nbsp;&nbsp;${s.coords[1]}<br>SCANNING... ${s.label}`;
}, 2500);

const camDir    = new THREE.Vector3();
const earthWPos = new THREE.Vector3();
const siteWPos  = new THREE.Vector3();
let   globeT    = 0;

function draw() {
  requestAnimationFrame(draw);
  globeT++;
  earth.rotation.y = INITIAL_ROT + globeT * 0.0015;
  camera.getWorldDirection(camDir);
  earth.getWorldPosition(earthWPos);
  siteObjs.forEach(({ dot, rings }) => {
    dot.getWorldPosition(siteWPos);
    const toSite  = siteWPos.clone().sub(earthWPos).normalize();
    const facing  = toSite.dot(camDir.clone().negate());
    const vis     = Math.max(0, Math.min(1, (facing - 0.05) / 0.2));
    dot.material.opacity = 0.95 * vis;
    rings.forEach(ring => {
      const p = (globeT * 0.007 + ring.userData.phase) % 1;
      ring.scale.setScalar(0.06 + p * 0.22);
      ring.material.opacity = Math.pow(1 - p, 2) * 0.85 * vis;
    });
  });
  renderer.render(scene, camera);
}

draw();
  </script>

</body>
</html>
