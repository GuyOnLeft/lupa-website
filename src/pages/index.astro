  <!-- Engagement tracking -->
  <script is:inline>
  (function(){
    function track(name, data){
      try { if (window.gtag) gtag('event', name, data || {}); } catch(e){}
      try { if (window.umami) umami.track(name, data || {}); } catch(e){}
    }
    var fired = {};
    function fireOnce(name, data){ if(!fired[name]){ fired[name]=1; track(name, data); } }
    window.addEventListener('scroll', function(){
      var h = document.documentElement;
      var pct = Math.round((h.scrollTop + window.innerHeight) / h.scrollHeight * 100);
      if (pct >= 25) fireOnce('scroll_25');
      if (pct >= 50) fireOnce('scroll_50');
      if (pct >= 75) fireOnce('scroll_75');
      if (pct >= 90) fireOnce('scroll_90');
    }, { passive: true });
    setTimeout(function(){ fireOnce('engaged_30s'); }, 30000);
    setTimeout(function(){ fireOnce('engaged_60s'); }, 60000);
    document.addEventListener('click', function(e){
      var a = e.target.closest && e.target.closest('a');
      if (!a) return;
      var href = a.getAttribute('href') || '';
      if (a.classList && a.classList.contains('bot-trap')) {
        e.preventDefault();
        track('bot_trap_click', { href: href, ua: navigator.userAgent });
        return;
      }
      if (href.indexOf('mailto:') === 0) track('mailto_click', { href: href });
      else if (/^https?:\/\//.test(href) && a.host !== location.host) track('outbound_click', { href: href });
    });
  })();
  </script>

