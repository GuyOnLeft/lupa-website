    .hero-content { position: relative; z-index: 1; max-width: 1100px; margin: 0 auto; padding: 0 40px; }
    .hero-eyebrow { font-size: 10px; color: #555; letter-spacing: 0.2em; text-transform: uppercase; margin-bottom: 20px; font-family: 'IBM Plex Mono', monospace; }
